             <VBox id="inputFldsVBoxIMobile" class="compactFieldsContainer" visible="true">
              
                <HBox id="detailsHox" alignItems="Center" justifyContent="Start" class="compactDetailsRow">
                    <VBox id="uomBox" class="compactFieldGroup">
                        <HBox id="yi" alignItems="Center" class="alignMyItems">
                       
                        <Label id="lblIutUerOMMobile" text="{=${i18n>Cart}  +'\u00a0'+ ':'+ '\u00a0'}" class="compactFieldLabel"/>
                        <Text id="txtInputUOMobile" text="{PickForCartMainModel>/DATA/CART}" class="compactFieldValuedups"/>
                        
                        </HBox>

                        <HBox id="yi1" alignItems="Center" class="alignMyItems">
                        <Label id="lblInputLeroationMobile" text="{=${i18n>BusModelNumber}  +'\u00a0'+ ':'+ '\u00a0'}" class="compactFieldLabel"/>
                        <Text id="txtInputocaertionMobile" text="{PickForCartMainModel>/HEAD/MODEL}" class="compactFieldValuedups"/>
                        </HBox>

                        <HBox id="ui4" alignItems="Center" class="alignMyItems">
                        <Label id="lblInputpcdUOM" text="{=${i18n>CartType}  +'\u00a0'+ ':'+ '\u00a0'}" labelFor="inputpcdUOM" class="compactFieldLabel"/>
                        <Text id="inputpcdUOM" text="{PickForCartMainModel>/DATA/CART_TYPE}" class="compactFieldValue"/>
                        </HBox>
                          
                    </VBox>
                   
                    <VBox id="binVByox" class="compactFieldGroup">
                        <HBox id="yu2" alignItems="Baseline" class="alignMyItems">
                         
                        <Label id="lblInutLerionMobile" text="{=${i18n>CartDescription}  +'\u00a0'+ ':'+ '\u00a0'}" class="compactFieldLabel"/>
                        <Text id="txtInputobile" text="{PickForCartMainModel>/DATA/CART_TYPE_DESC}" class="compactFieldValue"/>
                        </HBox>
                        <HBox id="yu3" alignItems="Baseline" class="alignMyItems">
                        <Label id="lblInpcatiMobile" text="{=${i18n>BusModel}  +'\u00a0'+ ':'+ '\u00a0'}" class="compactFieldLabel"/>
                         <Text id="txtInputcaeronMobile" text="{PickForCartMainModel>/HEAD/MODEL_DESC}" class="compactFieldValue"/>
                        </HBox>
                        <HBox id="tyu3" alignItems="Baseline" class="alignMyItems">
                         <Label id="lblInputPCDclass" text="{=${i18n>Class}  +'\u00a0'+ ':'+ '\u00a0'}" labelFor="inputPCDDclass" class="compactFieldLabel"/>
                        <Text id="inputPCDclass" text="{PickForCartMainModel>/HEAD/DEPT_DESC}" class="compactFieldValue"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
          
           
           

            <!-- Table for desktop/tablet only: scroll only the items -->
            <ScrollContainer id="desktopTablepcdScroll" width="100%" height="50vh" vertical="true" horizontal="false" >
                <Table id="pickpcdTable" sticky="ColumnHeaders" items="{PickForCartMainModel>/BUS}" mode="None" class="sapUiSmallMarginTop displayTableHeader myBlueHeaderTable" updateFinished="onPickTableUpdateFinished">
                    <columns>
                       
                        <Column id="colpcdItem"><header><Text id="txtColpcdItem" text="{i18n>BusNumber}"/></header></Column>
                        <Column id="colpcdItemDesc"><header><Text id="txtColpcdItemDesc" text="{i18n>CustomerName}"/></header></Column>
                        <Column id="colpcdDate"><header><Text id="txtColpcdDate" text="{i18n>Order}"/></header></Column>
                        <Column id="colpcdStat"><header><Text id="txtColpcdStat" text="{i18n>Stats}"/></header></Column>
                        
                    </columns>
                    <items>
                        <ColumnListItem id="pickTableRowpcdTemplate">
                            <cells>
                               
                                <Text id="rowpcdItem" text="{PickForCartMainModel>BUS}"/>
                                <Text id="rowpcdItemDesc" text="{PickForCartMainModel>NAME1}"/>
                                <Text id="rowpcdDate" text="{PickForCartMainModel>AUFNR}"/>
                                <Text id="rowpcdStat" text="{PickForCartMainModel>CART_STS_DESC}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </VBox>
        </content>
        <footer>
            <Bar id="prodOrderContinuePCDFooterBar" visible="{= ${device>/isPhone} || ${device>/isTablet}}">
                <contentMiddle>
                    <!-- <Button id="btnClearSelection" text="{i18n>clearSelection}" type="Unstyled" class="sapUiSmallMarginBegin doubleHeightButton lightBlueButton"  press="onClearSelection"/> -->
                    <Button id="btnChangeSttPCDIssue" text="{i18n>ChangeStatBtn}"  press="onChangeProcessStatus" type="Unstyled" class="doubleHeightButton lightBlueButton" />
                    <Button id="btnDisplayPCDIssue" text="{i18n>continueButton}"  press="onDisplayIssueItems" type="Unstyled" class="doubleHeightButton greenButton" />
                </contentMiddle>
            </Bar>
        </footer>
        <dependents>
            <ViewSettingsDialog id="sortPCDDialog" confirm="onSortConfirm" title="{i18n>sort}">
                <sortItems>
                    <ViewSettingsItem id="sortItemPCDAction" text="{i18n>LongBusNumber}" key="BUS"/>
                    <ViewSettingsItem id="sortItemPCDModel" text="{i18n>CustomerName}" key="NAME1"/>
                    <ViewSettingsItem id="sortItemPCDModelDesc" text="{i18n>FQA}" key="AUFNR"/>
                   
                </sortItems>
            </ViewSettingsDialog>
            <ViewSettingsDialog id="filterPCDDialog" confirm="onFilterConfirm" title="{i18n>filter}">
                <!-- Filter items are built dynamically in controller on beforeOpen -->
            </ViewSettingsDialog>
        </dependents>
    </Page>
</mvc:View>