    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form" xmlns:layout="sap.ui.layout">
    <Page id="pcdPage" title="{i18n>PickCartTitleDetails}" showNavButton="true" navButtonPress="onNavBack" enableScrolling="{= ${device>/isPhone} === true || ${device>/isTablet} === true }">
        <content>
        <VBox id="continuepcdVBox" class="sapUiSmallMargin" height="100%">
            <!-- Desktop/tablet actions toolbar -->
                <Toolbar id="prodOrderContinueToppcdToolbar" visible="{= ${device>/isPhone} === false &amp;&amp; ${device>/isTablet} === false}" class="topActionToolbar">
                    <!-- <Button id="btnClearSelectionpcdTop" text="{i18n>clearSelection}" type="Unstyled" class="sapUiSmallMarginBegin doubleHeightButton lightBlueButton"  press="onClearSelection"/> -->
                    <Button id="btnDisplayIssuepcdTop" text="{i18n>continueButton}"  press="onDisplayIssueItems" type="Unstyled" class="doubleHeightButton greenButton" />
                    <Button id="btnChangeSttIssuepcdTop" text="{i18n>ChangeStatBtn}"  press="onChangeProcessStatus" type="Unstyled" class="doubleHeightButton lightBlueButton" />
                    <ToolbarSpacer id="topToolbarpcdSpacer"/>
                    <Button id="btnSortpcdTop" icon="sap-icon://sort" text="{i18n>sort}" press="onOpenSortDialog"/>
                    <Button id="btnFilterpcdTop" icon="sap-icon://filter" text="{i18n>filter}" press="onOpenFilterDialog"/>
                </Toolbar>
           
          
