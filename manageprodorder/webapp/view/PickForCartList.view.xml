                    <ViewSettingsItem id="sortPCLItemModelDesc" text="{i18n>BusNumber}" key="MODEL_DESC"/>
                    <ViewSettingsItem id="sortPCLItemShortBus" text="{i18n>CartType}" key="CART_TYPE"/>
                    <ViewSettingsItem id="sortPCLItemDate" text="{i18n>CartTypeDescription}" key="CART_TYPE_DESC"/>
